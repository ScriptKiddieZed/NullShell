{
  "name": "tokyo-night",
  "settings": [
    {
      "settings": {
        "background": "#16161E",
        "foreground": "#C0CAF5",
        "lineHighlight": "#1F2335",
        "selection": "#2E3C64",
        "highlightedDelimitersForeground": "#BB9AF7"
      }
    },
    {
      "name": "Comment",
      "scope": "comment,punctuation.definition.comment",
      "settings": {
        "foreground": "#565F89",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": "string,string.quoted,string.template",
      "settings": {
        "foreground": "#9ECE6A"
      }
    },
    {
      "name": "Escape",
      "scope": "constant.character.escape,string.character.escape",
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#FF9E64"
      }
    },
    {
      "name": "Constant",
      "scope": "constant.language,constant.other,variable.language,support.constant",
      "settings": {
        "foreground": "#FF9E64"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword,keyword.control,storage,storage.type,storage.modifier",
      "settings": {
        "foreground": "#BB9AF7"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator,keyword.operator.assignment,keyword.operator.arithmetic,keyword.operator.logical,keyword.operator.comparison",
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Function",
      "scope": "entity.name.function,support.function,meta.function-call",
      "settings": {
        "foreground": "#7AA2F7"
      }
    },
    {
      "name": "Type",
      "scope": "entity.name.type,entity.name.class,support.type,support.class,entity.other.inherited-class,meta.return.type",
      "settings": {
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "Variable",
      "scope": "variable,variable.other,variable.parameter",
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter,operator.rest.parameters",
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "Property",
      "scope": "variable.property,variable.other.property,support.variable.property,meta.object-literal.key,support.type.property-name",
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag,punctuation.definition.tag.html,punctuation.definition.tag.begin,punctuation.definition.tag.end",
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#BB9AF7"
      }
    },
    {
      "name": "Regex",
      "scope": "string.regexp,regex",
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation,meta.brace",
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Heading",
      "scope": "markup.heading,entity.name.section",
      "settings": {
        "foreground": "#7AA2F7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#BB9AF7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#BB9AF7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link",
      "scope": "markup.underline.link,string.other.link",
      "settings": {
        "foreground": "#7AA2F7"
      }
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#9ECE6A"
      }
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "name": "CSS class",
      "scope": "entity.other.attribute-name.class.css,entity.other.attribute-name.class.scss",
      "settings": {
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "CSS property value",
      "scope": "support.constant.property-value.css,support.constant.property-value.scss,keyword.other.unit.css",
      "settings": {
        "foreground": "#FF9E64"
      }
    },
    {
      "name": "Shell variable",
      "scope": "variable.other.normal.shell,punctuation.definition.variable.shell",
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "YAML key",
      "scope": "entity.name.tag.yaml,string.unquoted.plain.out.yaml",
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "name": "JSON key",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#F7768E"
      }
    }
  ]
}